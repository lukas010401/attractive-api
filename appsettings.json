{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=attractive_catalog;Username=postgres;Password=postgres"
  },
  "Database": {
    "UseInMemory": false
  },
  "Frontend": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000"
    ]
  },
  "Jwt": {
    "Issuer": "AttractiveCatalog.Api",
    "Audience": "AttractiveCatalog.Frontend",
    "Key": "CHANGE_THIS_SUPER_SECRET_KEY_AT_LEAST_32_CHARS",
    "ExpiryMinutes": 60,
    "RefreshTokenDays": 15
  },
  "Media": {
    "MaxImagesPerProduct": 10,
    "MaxImageSizeMb": 5,
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".webp"],
    "UploadsRoot": "wwwroot/uploads"
  },
  "AdminSeed": {
    "Email": "admin@attractive.mg",
    "Password": "CHANGE_THIS_ADMIN_PASSWORD"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
